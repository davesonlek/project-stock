            }
          }
        }
      ]
    },
    {
      "name": "04 Stock Documents",
      "item": [
        {
          "name": "List Stock Documents",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Organization-Id", "value": "{{organization_id}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/stock/documents",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "documents"]
            }
          }
        },
        {
          "name": "Create Document Header",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set('document_id', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Organization-Id", "value": "{{organization_id}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_type\": \"RECEIVE\",\n  \"destination_warehouse_id\": {{warehouse_id}},\n  \"destination_location_id\": {{location_id}},\n  \"remarks\": \"Demo Receive Shipment\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/stock/documents",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "documents"]
            }
          }
        },
        {
          "name": "Add Document Line",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Organization-Id", "value": "{{organization_id}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goods_id\": {{goods_id}},\n  \"quantity\": 50\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/stock/documents/{{document_id}}/lines",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "documents", "{{document_id}}", "lines"]
            }
          }
        },
        {
          "name": "Submit Document",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Organization-Id", "value": "{{organization_id}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/stock/documents/{{document_id}}/submit",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "documents", "{{document_id}}", "submit"]
            }
          }
        },
        {
          "name": "Approve Document",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Organization-Id", "value": "{{organization_id}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/stock/documents/{{document_id}}/approve",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "documents", "{{document_id}}", "approve"]
            }
          }
        },
        {
          "name": "Post Stock Document",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Organization-Id", "value": "{{organization_id}}" },
              { "key": "Idempotency-Key", "value": "idem-{{$guid}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/stock/documents/{{document_id}}/post",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "documents", "{{document_id}}", "post"]
            }
          }
        },
        {
          "name": "Reverse Stock Document",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "X-Organization-Id", "value": "{{organization_id}}" },
              { "key": "Idempotency-Key", "value": "rev-{{$guid}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Goods damaged during offloading\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/stock/documents/{{document_id}}/reverse",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "stock", "documents", "{{document_id}}", "reverse"]
            }
          }
        }
      ]
    },
