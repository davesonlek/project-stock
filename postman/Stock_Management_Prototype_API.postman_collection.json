              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/goods",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "goods"]
            }
          }
        },
        {
          "name": "List Warehouses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
